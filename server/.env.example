# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inmogestion?schema=public"

# JWT
JWT_SECRET="change-me-super-secret-access-token-key-256bits"
JWT_REFRESH_SECRET="change-me-super-secret-refresh-token-key-256bits"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudflare R2
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="inmogestion-photos"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# Redis (for BullMQ)
REDIS_URL="redis://localhost:6379"

# Resend (email)
RESEND_API_KEY="re_xxxx"
RESEND_FROM_EMAIL="noreply@inmogestion.com"

# Frontend URL (for CORS)
CLIENT_URL="http://localhost:5173"
